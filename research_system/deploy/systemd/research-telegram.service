[Unit]
Description=India Research Monitor — Telegram bot (long-polling)
After=network-online.target research-scheduler.service
Wants=network-online.target

[Service]
Type=simple
# === EDIT THESE TWO LINES ===
User=ubuntu
WorkingDirectory=/home/ubuntu/dashboard
# ============================
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/dashboard/.env
ExecStart=/home/ubuntu/dashboard/research_system/.venv/bin/python -m research_system.telegram_bot
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/research-telegram.log
StandardError=append:/var/log/research-telegram.log

[Install]
WantedBy=multi-user.target
