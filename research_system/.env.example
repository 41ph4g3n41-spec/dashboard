# Pick exactly one LLM provider:
#   LLM_PROVIDER=anthropic  (default) — paid, best quality
#   LLM_PROVIDER=gemini             — Google AI Studio, free tier 500 req/day
LLM_PROVIDER=anthropic

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Gemini (used when LLM_PROVIDER=gemini, free) ---
# Get a key at https://aistudio.google.com/apikey  (no credit card needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Upstox broker feed (read-only).
# Unlocks the "Portfolio (Upstox)" tab — real demat holdings with cost basis
# and P&L — and makes Upstox the preferred price source, with yfinance as
# the fallback. Generate a token at https://account.upstox.com/developer/apps
#
# SECURITY: this is a bearer credential for your live broking account.
# Never commit it, never paste it into an issue/PR/chat. Rotate it in the
# developer console the moment it leaks.
UPSTOX_ACCESS_TOKEN=

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email for morning brief (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# Optional: Turso hosted libSQL so VPS scheduler + Streamlit Cloud
# dashboard share the same database. Leave blank for local-only SQLite.
# Get these from https://turso.tech (free tier: 5 GB).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_SYNC_INTERVAL=30
