# Required
ANTHROPIC_API_KEY=sk-ant-...

# Model
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email for morning brief (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# Optional: Turso hosted libSQL so VPS scheduler + Streamlit Cloud
# dashboard share the same database. Leave blank for local-only SQLite.
# Get these from https://turso.tech (free tier: 5 GB).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_SYNC_INTERVAL=30
