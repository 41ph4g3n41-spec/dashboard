# Pick exactly one LLM provider:
#   LLM_PROVIDER=anthropic  (default) — paid, best quality
#   LLM_PROVIDER=gemini             — Google AI Studio, free tier 500 req/day
LLM_PROVIDER=anthropic

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Gemini (used when LLM_PROVIDER=gemini, free) ---
# Get a key at https://aistudio.google.com/apikey  (no credit card needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email for morning brief (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# Optional: Turso hosted libSQL so VPS scheduler + Streamlit Cloud
# dashboard share the same database. Leave blank for local-only SQLite.
# Get these from https://turso.tech (free tier: 5 GB).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_SYNC_INTERVAL=30

# --- Upstox live market data (Live Markets tab) ---
# Real-time NSE/BSE/MCX ticks over the Market Data Feed V3 websocket:
# indices, cash equities, futures, and option chains with greeks.
# Generate via the OAuth flow at https://account.upstox.com/developer/apps
# NOTE: standard tokens expire 03:30 IST the next day; extended tokens
# (JWT claim isExtended, paid plans) last ~1 year. Check the exp claim.
UPSTOX_ACCESS_TOKEN=
