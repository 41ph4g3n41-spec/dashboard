# Streamlit Community Cloud secrets — paste this content into:
#   App dashboard ▸ Settings ▸ Secrets
#
# Locally, copy this to `.streamlit/secrets.toml` (gitignored).

ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL   = "claude-sonnet-4-5"

# Optional — for the Telegram bot + outbound alerts
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID   = ""

# Optional — email morning brief
SMTP_HOST = ""
SMTP_PORT = "587"
SMTP_USER = ""
SMTP_PASS = ""
EMAIL_TO  = ""
