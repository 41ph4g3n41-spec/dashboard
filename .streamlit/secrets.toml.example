# Streamlit Community Cloud secrets — paste this content into:
#   App dashboard ▸ Settings ▸ Secrets
#
# Locally, copy this to `.streamlit/secrets.toml` (gitignored).

# Pick a provider — "anthropic" (paid) or "gemini" (free)
LLM_PROVIDER = "anthropic"

# Anthropic (paid)
ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL   = "claude-sonnet-4-5"

# OR Gemini (free) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY = ""
GEMINI_MODEL   = "gemini-2.5-flash"

# Recommended — Turso hosted libSQL so this Cloud dashboard sees the
# data your VPS scheduler collects. Free tier: 5 GB at turso.tech.
TURSO_DATABASE_URL  = "libsql://<your-db>-<your-org>.turso.io"
TURSO_AUTH_TOKEN    = ""
TURSO_SYNC_INTERVAL = "30"

# Optional — for the Telegram bot + outbound alerts (bot runs on VPS, not here)
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID   = ""

# Optional — email morning brief
SMTP_HOST = ""
SMTP_PORT = "587"
SMTP_USER = ""
SMTP_PASS = ""
EMAIL_TO  = ""

# Optional — Upstox live market data for the "Live Markets" tab.
# Real-time Indian ticks (indices / equities / futures / options).
# Standard tokens expire 03:30 IST the next day; extended tokens (JWT claim
# isExtended, paid plans) last ~1 year. Check the token's exp claim.
UPSTOX_ACCESS_TOKEN = ""
